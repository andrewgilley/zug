package zug:edge-inference@0.1.0;

interface tensors {
  enum dtype {
    float32,
    int64,
    int32,
    uint8,
    bool,
  }

  record tensor-desc {
    dtype: dtype,
    shape: list<u64>,
    byte-len: u64,
  }

  record tensor {
    desc: tensor-desc,
    data: list<u8>,
  }
}

interface inference {
  use tensors.{tensor, tensor-desc};

  enum graph-encoding {
    onnx,
  }

  enum execution-target {
    cpu,
  }

  variant inference-error {
    invalid-encoding,
    invalid-target,
    invalid-graph-handle,
    invalid-context-handle,
    invalid-input,
    unsupported-dtype,
    unsupported-op(string),
    buffer-too-small,
    model-too-large,
    missing-model,
    runtime-error(string),
  }

  type graph = u32;

  type context = u32;

  load-graph: func(
    model: list<u8>,
    encoding: graph-encoding,
    target: execution-target,
  ) -> result<graph, inference-error>;

  load-preloaded-graph: func(
    encoding: graph-encoding,
    target: execution-target,
  ) -> result<graph, inference-error>;

  init-execution-context: func(
    graph: graph,
  ) -> result<context, inference-error>;

  set-input: func(
    context: context,
    index: u32,
    value: tensor,
  ) -> result<_, inference-error>;

  compute: func(
    context: context,
  ) -> result<_, inference-error>;

  output-desc: func(
    context: context,
    index: u32,
  ) -> result<tensor-desc, inference-error>;

  output: func(
    context: context,
    index: u32,
  ) -> result<tensor, inference-error>;
}

interface diagnostics {
  use inference.{graph-encoding, execution-target, inference-error};

  record target-profile {
    name: string,
    max-model-bytes: u64,
    max-memory-pages: u32,
    supported-ops: list<string>,
    supported-dtypes: list<string>,
  }

  record compatibility-report {
    compatible: bool,
    profile: target-profile,
    errors: list<inference-error>,
    warnings: list<string>,
  }

  inspect-model: func(
    model: list<u8>,
    encoding: graph-encoding,
    target: execution-target,
    profile: target-profile,
  ) -> compatibility-report;
}

interface log {
  write: func(
    message: string,
  );
}

world edge-guest {
  import inference;
  import diagnostics;
  import log;

  export run: func() -> result<_, inference.inference-error>;
}
